# =============================================================================
# Scrapix Environment Configuration
# =============================================================================
# Copy this file to .env and update the values as needed
# =============================================================================

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
# standalone = self-hosted: one operator key (SCRAPIX_ADMIN_KEY, >= 16 chars)
# guards every protected route, and the engine keeps its own job history in
# SQLite (DATABASE_URL defaults to sqlite://./data/scrapix.db).
# hosted = behind the Meilisearch Lab (meilisearch/lab); see the commented
# block below.
SCRAPIX_MODE=standalone
SCRAPIX_ADMIN_KEY=dev-admin-key-change-me

HOST=0.0.0.0
PORT=8080
ENABLE_CORS=true

# Optional: the engine's own job-history store. SQLite by default; or a
# dedicated postgres:// database the engine migrates itself.
# DATABASE_URL=sqlite://./data/scrapix.db

# -----------------------------------------------------------------------------
# Hosted against a local Lab (optional)
# -----------------------------------------------------------------------------
# Run the Lab from a meilisearch/lab checkout (`just dev` there: Rails on
# :8081, Postgres on :5433 with a `scrapix_engine` database). Mint this
# engine's credentials on the Lab (`bin/rails lab:hosted_engine:create
# PRODUCT=scrapix REGION=dev URL=http://localhost:8080`), then replace the
# two standalone lines above with the block below. The engine's DATABASE_URL
# is its own database, never the Lab's.
# SCRAPIX_MODE=hosted
# LAB_URL=http://localhost:8081
# LAB_INSTANCE_ID=<uuid printed by the Lab>
# LAB_INSTANCE_SECRET=<64 hex printed by the Lab>
# LAB_SERVICE_TOKEN=dev-lab-service-token-change-in-production-0000
# DATABASE_URL=postgres://scrapix:scrapix@localhost:5433/scrapix_engine
#
# A standalone engine has no Lab: LAB_INSTANCE_ID / LAB_INSTANCE_SECRET are
# refused with SCRAPIX_MODE=standalone.

# -----------------------------------------------------------------------------
# Kafka/Redpanda Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of broker addresses
KAFKA_BROKERS=localhost:19092

# Consumer group IDs (usually set per-service)
# KAFKA_GROUP_ID=scrapix-crawlers

# -----------------------------------------------------------------------------
# Meilisearch Configuration
# -----------------------------------------------------------------------------
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# -----------------------------------------------------------------------------
# Redis/DragonflyDB Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# -----------------------------------------------------------------------------
# ClickHouse Configuration (Analytics)
# -----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=scrapix
CLICKHOUSE_USER=scrapix
CLICKHOUSE_PASSWORD=scrapix

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log levels: error, warn, info, debug, trace
# Can be filtered per-module: RUST_LOG=info,scrapix=debug
RUST_LOG=info,scrapix=debug

# -----------------------------------------------------------------------------
# Frontier Service Configuration
# -----------------------------------------------------------------------------
# Tuned for high-throughput multi-site crawling
DISPATCH_INTERVAL_MS=20
DISPATCH_BATCH_SIZE=2000
DOMAIN_DELAY_MS=250
CONCURRENT_PER_DOMAIN=4
BLOOM_CAPACITY=10000000
BLOOM_FP_RATE=0.01

# -----------------------------------------------------------------------------
# Crawler Worker Configuration
# -----------------------------------------------------------------------------
# Tuned for high-throughput multi-site crawling
CONCURRENCY=50
USER_AGENT=Scrapix/1.0 (compatible; +https://github.com/qdequele/scrapix)
REQUEST_TIMEOUT=30
MAX_RETRIES=3
MAX_DEPTH=100
MAX_BODY_SIZE=10485760
RESPECT_ROBOTS=true

# -----------------------------------------------------------------------------
# Content Worker Configuration
# -----------------------------------------------------------------------------
# Tuned for high-throughput multi-site crawling
BATCH_SIZE=2000
BATCH_TIMEOUT_SECS=5

# -----------------------------------------------------------------------------
# AI Features (Optional)
# -----------------------------------------------------------------------------
# Required for AI extraction, summarization, and embeddings
# OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# Telemetry (Optional)
# -----------------------------------------------------------------------------
# OpenTelemetry OTLP endpoint for distributed tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus metrics port
# METRICS_PORT=9090
