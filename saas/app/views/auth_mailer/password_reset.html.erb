<% reset_url = console_url("/reset-password?token=#{@token}") %>
<%= em_heading("Reset Your Password") %>
<%= em_paragraph("We received a request to reset the password for your Scrapix account.") %>
<%= em_button(reset_url, "Reset Password") %>
<%= em_muted("Or copy this link: <span style=\"color: #818cf8; word-break: break-all;\">#{reset_url}</span>") %>
<%= em_alert("This link expires in 1 hour.", :warning) %>
<%= em_muted("If you didn't request a password reset, you can safely ignore this email. Your password will not be changed.") %>
