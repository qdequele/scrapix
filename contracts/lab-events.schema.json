{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrapix.meilisearch.com/contracts/lab-events.schema.json",
  "title": "Scrapix Lab event",
  "description": "One event the Scrapix engine reports to the Lab (Rails) at POST /internal/events. Delivered in batches as {\"events\": [<event>, ...]}. The engine's LabEvent (bins/scrapix-api/src/lab_events.rs) and the Rails receiver (saas/app/controllers/internal/events_controller.rb) are both tested against this file.",
  "type": "object",
  "required": ["id", "type", "occurred_at", "account_id", "api_key_id", "product", "data"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/uuid", "description": "Idempotency key. UUIDv7 for request usage; UUIDv5(LAB_NAMESPACE, \"job:{job_id}:final\") for a crawl's final usage; UUIDv5(LAB_NAMESPACE, \"job:{job_id}:lifecycle\") for job.completed / job.failed." },
    "type": { "enum": ["usage.recorded", "job.completed", "job.failed"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "account_id": { "$ref": "#/$defs/uuid" },
    "api_key_id": { "type": ["string", "null"] },
    "product": { "const": "scrapix" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "usage.recorded" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/usageData" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.completed" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/jobCompletedData" } } }
    },
    {
      "if": { "properties": { "type": { "const": "job.failed" } }, "required": ["type"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/jobFailedData" } } }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "usageData": {
      "type": "object",
      "required": ["operation", "credits", "units", "description"],
      "additionalProperties": false,
      "properties": {
        "operation": { "enum": ["scrape", "map", "search", "parse", "ocr", "extract", "crawl"] },
        "credits": { "type": "integer", "minimum": 0 },
        "units": { "type": "object" },
        "description": { "type": "string" },
        "job_id": { "type": "string" }
      }
    },
    "jobCompletedData": {
      "type": "object",
      "required": ["job_id", "index_uid", "pages_crawled", "documents_indexed", "duration_secs"],
      "additionalProperties": false,
      "properties": {
        "job_id": { "type": "string" },
        "index_uid": { "type": "string" },
        "pages_crawled": { "type": "integer", "minimum": 0 },
        "documents_indexed": { "type": "integer", "minimum": 0 },
        "duration_secs": { "type": "integer", "minimum": 0 }
      }
    },
    "jobFailedData": {
      "type": "object",
      "required": ["job_id", "error_message", "pages_crawled"],
      "additionalProperties": false,
      "properties": {
        "job_id": { "type": "string" },
        "error_message": { "type": "string" },
        "pages_crawled": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
