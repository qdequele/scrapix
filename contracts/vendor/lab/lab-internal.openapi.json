{
  "openapi": "3.1.0",
  "info": {
    "title": "Meilisearch Lab internal API",
    "version": "1",
    "description": "Service API the hosted product engines (Scrapix, Lumen, glutony) call on the Lab (Rails) control plane instead of reading the Lab database. Every endpoint except `POST /internal/events` requires `X-Lab-Instance-Id` plus `Authorization: Bearer <LAB_INSTANCE_SECRET>`; a missing or wrong credential gets 401. For one transition release the legacy `Authorization: Bearer <LAB_SERVICE_TOKEN>` without an instance id is still accepted and acts as the hosted Scrapix engine. `POST /internal/events` is signed per deployment instead (see its description)."
  },
  "security": [
    {
      "instanceSecret": [],
      "instanceId": []
    },
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/internal/ping": {
      "get": {
        "operationId": "ping",
        "summary": "Liveness and service-token check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ping"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/auth/introspect": {
      "post": {
        "operationId": "introspectCredential",
        "summary": "Resolve a client credential to an account (RFC 7662 style)",
        "description": "Always 200 with `{\"active\":false}` for any invalid credential. 400 for an unknown `kind` or a missing `credential`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntrospectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Introspection result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Introspection"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or missing credential"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Tier and spendable balance of an account",
        "description": "200 with `{\"active\":false}` for an unknown or inactive account, or a non-UUID id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account lookup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLookup"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/accounts/{account_id}/meilisearch": {
      "get": {
        "operationId": "getAccountMeilisearch",
        "summary": "The account's Meilisearch target (decrypted key)",
        "description": "With `url`, the account's engine whose URL matches (trailing slash ignored); without it, the default engine. `api_key` is the decrypted key, `\"\"` when none is set. 404 `{\"error\":\"not_found\"}` when nothing matches or the account id is not a UUID.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meilisearch target",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeilisearchTarget"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No matching engine",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    },
    "/internal/accounts/{account_id}/ai": {
      "get": {
        "operationId": "getAccountAi",
        "summary": "A hosted engine's LLM target: the team's Gateway and the engine's key",
        "description": "Only the hosted Scrapix and Pipelines engines may call it (any other product gets 403 `{\"error\":\"forbidden\"}`). `base_url` is the team's hosted Gateway (Lumen) OpenAI-compatible base (`<engine url>/v1`); `api_key` is the team's virtual key for the calling engine (`lab-scrapix` for Scrapix, `lab-pipelines` for Pipelines), minted on first use and kept by the Lab; `key_id` names it. `default_model` and `vision_model` are the models to ask for; Pipelines also gets `decision_model`, the model its `jev_enricher` asks for. `cache_ttl` is the seconds the answer may be cached. When the Gateway refuses the key, call again with `rejected_key_id` set to the `key_id` it refused: the Lab replaces the stored key only if it is still that one, so a stale id gets the current key back. 404 `{\"error\":\"not_found\"}` when the account id is not a UUID, the team has no built-in Gateway or it has no hosted engine. 502 `{\"error\":\"gateway_unavailable\",\"message\":...}` when the Gateway could not mint the key.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "rejected_key_id",
            "in": "query",
            "required": false,
            "description": "The `key_id` the Gateway refused; the Lab mints a new key when it still stores that one.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The Gateway target",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiTarget"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "The caller is not a hosted Scrapix or Pipelines engine",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "forbidden"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No Gateway for this account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "502": {
            "description": "The Gateway could not mint the key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "gateway_unavailable"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/instances/me": {
      "get": {
        "operationId": "getSelf",
        "summary": "What the Lab knows about the calling deployment",
        "description": "On the legacy service-token path there is no deployment row, so `instance_id` and `region` can be null.",
        "responses": {
          "200": {
            "description": "Self description",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "instance_id",
                    "kind",
                    "product",
                    "region",
                    "lab_url"
                  ],
                  "properties": {
                    "instance_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The deployment's LAB_INSTANCE_ID; null on the legacy service-token path"
                    },
                    "kind": {
                      "enum": [
                        "hosted"
                      ]
                    },
                    "product": {
                      "enum": [
                        "scrapix",
                        "lumen",
                        "glutony"
                      ]
                    },
                    "region": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Null when the deployment has no region (always on the legacy path)"
                    },
                    "lab_url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/events": {
      "post": {
        "operationId": "postEvents",
        "summary": "Report usage and job events (contract v2 section 4)",
        "description": "Signed per deployment: X-Lab-Instance-Id, X-Lab-Timestamp (unix seconds, within 300 s) and X-Lab-Signature: sha256=HMAC-SHA256(LAB_INSTANCE_SECRET, \"<timestamp>.<raw body>\"). For one transition release the legacy `X-Scrapix-Signature: sha256=HMAC-SHA256(LAB_EVENTS_SECRET, \"<raw body>\")` without an instance id is still accepted (503 when the Lab has no legacy secret configured). At most 500 events. Events are described by contracts/lab-events.schema.json. Ids missing from `accepted` were skipped (logged by the Lab) and must be dropped by the engine after 24 h.",
        "security": [],
        "parameters": [
          {
            "name": "X-Lab-Instance-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Lab-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "X-Lab-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "events"
                ],
                "properties": {
                  "events": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted ids",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accepted"
                  ],
                  "properties": {
                    "accepted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed body or more than 500 events"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "description": "Legacy path only: the Lab has no legacy events secret configured"
          }
        }
      }
    },
    "/internal/deploys": {
      "post": {
        "operationId": "postDeploys",
        "summary": "Report deploy attempts of the Lab and the hosted engines (qdq-server autodeploy)",
        "description": "Called by qdq-server's autodeploy scripts, not by an engine: each deploy attempt of the Lab, the Scrapix engine, the hosted Gateway (Lumen) and Pipelines (glutony), once when it starts and once when it ends, listed on Admin > Deploys. Signed with the box's own key: X-Lab-Timestamp (unix seconds, within 300 s) and X-Lab-Signature: sha256=HMAC-SHA256(LAB_DEPLOYS_SECRET, \"<timestamp>.<raw body>\"); during a rotation LAB_DEPLOYS_SECRET holds both keys, comma-separated. 503 while LAB_DEPLOYS_SECRET is unset. At most 100 reports. A report is the whole attempt; its id makes a resend harmless, and a `started` report never reopens an attempt that ended. The reporter drops every id in `accepted` and `rejected`.",
        "security": [],
        "parameters": [
          {
            "name": "X-Lab-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "X-Lab-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "deploys"
                ],
                "properties": {
                  "deploys": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/DeployReport"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored and refused reports",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accepted",
                    "rejected"
                  ],
                  "properties": {
                    "accepted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rejected": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed body or more than 100 reports"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "description": "LAB_DEPLOYS_SECRET is not set: keep the reports and retry"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Deprecated: legacy LAB_SERVICE_TOKEN, removed next release"
      },
      "instanceSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "LAB_INSTANCE_SECRET of the calling hosted engine (64 hex chars), with X-Lab-Instance-Id"
      },
      "instanceId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lab-Instance-Id",
        "description": "LAB_INSTANCE_ID (uuid)"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or wrong engine credentials (or, for events, a bad signature or stale timestamp)"
      }
    },
    "schemas": {
      "Ping": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "Inactive": {
        "type": "object",
        "required": [
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "Credits": {
        "type": "object",
        "required": [
          "balance"
        ],
        "properties": {
          "balance": {
            "type": "integer",
            "description": "Stored balance minus usage received but not yet debited"
          }
        }
      },
      "IntrospectionRequest": {
        "type": "object",
        "required": [
          "kind",
          "credential"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "`bearer` is the value of `Authorization: Bearer`: an `sk_live_`/`sk_test_` credential resolves as that API key (principal `api_key`), anything else as an OAuth access token.",
            "enum": [
              "api_key",
              "bearer",
              "session"
            ]
          },
          "credential": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "account_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Session only: the selected account (X-Account-Id). Defaults to the first membership."
          }
        }
      },
      "Principal": {
        "type": "object",
        "required": [
          "type",
          "user_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "api_key",
              "oauth",
              "session"
            ]
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "IntrospectionActive": {
        "type": "object",
        "required": [
          "active",
          "account_id",
          "tier",
          "role",
          "api_key_id",
          "principal",
          "credits",
          "cache_ttl"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "const": true
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "starter",
              "pro",
              "enterprise"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "Membership role for sessions, null otherwise"
          },
          "api_key_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          },
          "credits": {
            "$ref": "#/components/schemas/Credits"
          },
          "cache_ttl": {
            "type": "integer",
            "description": "Seconds the engine may cache this answer: 30, or fewer for a session or OAuth token that expires sooner (never past the credential's expiry; 0 = do not cache)"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits"
          }
        }
      },
      "Introspection": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/IntrospectionActive"
          },
          {
            "$ref": "#/components/schemas/Inactive"
          }
        ]
      },
      "AccountActive": {
        "type": "object",
        "required": [
          "active",
          "account_id",
          "tier",
          "credits",
          "cache_ttl"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "const": true
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "starter",
              "pro",
              "enterprise"
            ]
          },
          "credits": {
            "$ref": "#/components/schemas/Credits"
          },
          "cache_ttl": {
            "type": "integer"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits"
          }
        }
      },
      "AccountLookup": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AccountActive"
          },
          {
            "$ref": "#/components/schemas/Inactive"
          }
        ]
      },
      "MeilisearchTarget": {
        "type": "object",
        "required": [
          "id",
          "url",
          "api_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "description": "Decrypted Meilisearch API key; empty string when none is set"
          }
        }
      },
      "AiTarget": {
        "type": "object",
        "required": [
          "base_url",
          "api_key",
          "key_id",
          "default_model",
          "vision_model",
          "cache_ttl"
        ],
        "properties": {
          "base_url": {
            "type": "string",
            "description": "OpenAI-compatible base of the team's hosted Gateway, ending in /v1"
          },
          "api_key": {
            "type": "string",
            "description": "The calling engine's virtual key on the team's Gateway (fg-...): lab-scrapix or lab-pipelines"
          },
          "key_id": {
            "type": "string",
            "description": "The Gateway's id for that key; send it back as rejected_key_id when the Gateway refuses the key"
          },
          "default_model": {
            "type": "string"
          },
          "vision_model": {
            "type": "string"
          },
          "decision_model": {
            "type": "string",
            "description": "Pipelines only: the model `jev_enricher` asks for"
          },
          "cache_ttl": {
            "type": "integer",
            "description": "Seconds the answer may be cached"
          }
        }
      },
      "NotFound": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "const": "not_found"
          }
        }
      },
      "PlanLimits": {
        "type": "object",
        "description": "Limits an engine enforces for the account (contract v2 section 5). Pricing is usage-based, so every account gets the same limits whatever its tier",
        "required": [
          "concurrent_jobs",
          "rate_limit_rpm",
          "max_depth",
          "js_rendering"
        ],
        "properties": {
          "concurrent_jobs": {
            "type": "integer"
          },
          "rate_limit_rpm": {
            "type": "integer"
          },
          "max_depth": {
            "type": "integer"
          },
          "js_rendering": {
            "type": "boolean"
          }
        }
      },
      "DeployReport": {
        "type": "object",
        "required": [
          "id",
          "product",
          "repo",
          "status",
          "trigger"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The attempt's id: the same in its started and its final report"
          },
          "product": {
            "type": "string",
            "enum": [
              "lab",
              "scrapix",
              "gateway",
              "pipelines"
            ]
          },
          "repo": {
            "type": "string",
            "description": "owner/name on GitHub",
            "examples": [
              "qdequele/lumen"
            ]
          },
          "commit_sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "7 to 40 hex chars"
          },
          "previous_commit_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "description": "The release (a Lumen tag) or the version the service reports"
          },
          "previous_version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "status": {
            "type": "string",
            "enum": [
              "started",
              "succeeded",
              "failed",
              "rolled_back",
              "manual_intervention",
              "cancelled"
            ]
          },
          "attempt": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "Which try at this commit or release"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "timer",
              "force",
              "drill",
              "backfill"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it failed, or a note; cut at 2000 chars. Never secrets"
          },
          "host": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Null while the attempt runs"
          }
        }
      }
    }
  }
}
