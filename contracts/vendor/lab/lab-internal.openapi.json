{
  "openapi": "3.1.0",
  "info": {
    "title": "Meilisearch Lab internal API",
    "version": "1",
    "description": "Service API the hosted product engines (Scrapix, Lumen, glutony) call on the Lab (Rails) control plane instead of reading the Lab database. Every endpoint except `POST /internal/events` requires `X-Lab-Instance-Id` plus `Authorization: Bearer <LAB_INSTANCE_SECRET>`; a missing or wrong credential gets 401. For one transition release the legacy `Authorization: Bearer <LAB_SERVICE_TOKEN>` without an instance id is still accepted and acts as the hosted Scrapix engine. `POST /internal/events` is signed per deployment instead (see its description)."
  },
  "security": [
    {
      "instanceSecret": [],
      "instanceId": []
    },
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/internal/ping": {
      "get": {
        "operationId": "ping",
        "summary": "Liveness and service-token check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ping"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/auth/introspect": {
      "post": {
        "operationId": "introspectCredential",
        "summary": "Resolve a client credential to an account (RFC 7662 style)",
        "description": "Always 200 with `{\"active\":false}` for any invalid credential. 400 for an unknown `kind` or a missing `credential`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntrospectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Introspection result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Introspection"
                }
              }
            }
          },
          "400": {
            "description": "Unknown kind or missing credential"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "Tier and spendable balance of an account",
        "description": "200 with `{\"active\":false}` for an unknown or inactive account, or a non-UUID id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account lookup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLookup"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/accounts/{account_id}/meilisearch": {
      "get": {
        "operationId": "getAccountMeilisearch",
        "summary": "The account's Meilisearch target (decrypted key)",
        "description": "With `url`, the account's engine whose URL matches (trailing slash ignored); without it, the default engine. `api_key` is the decrypted key, `\"\"` when none is set. 404 `{\"error\":\"not_found\"}` when nothing matches or the account id is not a UUID.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meilisearch target",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeilisearchTarget"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No matching engine",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          }
        }
      }
    },
    "/internal/instances/me": {
      "get": {
        "operationId": "getSelf",
        "summary": "What the Lab knows about the calling deployment",
        "description": "On the legacy service-token path there is no deployment row, so `instance_id` and `region` can be null.",
        "responses": {
          "200": {
            "description": "Self description",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "instance_id",
                    "kind",
                    "product",
                    "region",
                    "lab_url"
                  ],
                  "properties": {
                    "instance_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The deployment's LAB_INSTANCE_ID; null on the legacy service-token path"
                    },
                    "kind": {
                      "enum": [
                        "hosted"
                      ]
                    },
                    "product": {
                      "enum": [
                        "scrapix",
                        "lumen",
                        "glutony"
                      ]
                    },
                    "region": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Null when the deployment has no region (always on the legacy path)"
                    },
                    "lab_url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/internal/events": {
      "post": {
        "operationId": "postEvents",
        "summary": "Report usage and job events (contract v2 section 4)",
        "description": "Signed per deployment: X-Lab-Instance-Id, X-Lab-Timestamp (unix seconds, within 300 s) and X-Lab-Signature: sha256=HMAC-SHA256(LAB_INSTANCE_SECRET, \"<timestamp>.<raw body>\"). For one transition release the legacy `X-Scrapix-Signature: sha256=HMAC-SHA256(LAB_EVENTS_SECRET, \"<raw body>\")` without an instance id is still accepted (503 when the Lab has no legacy secret configured). At most 500 events. Events are described by contracts/lab-events.schema.json. Ids missing from `accepted` were skipped (logged by the Lab) and must be dropped by the engine after 24 h.",
        "security": [],
        "parameters": [
          {
            "name": "X-Lab-Instance-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Lab-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "X-Lab-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "events"
                ],
                "properties": {
                  "events": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted ids",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accepted"
                  ],
                  "properties": {
                    "accepted": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed body or more than 500 events"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "description": "Legacy path only: the Lab has no legacy events secret configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Deprecated: legacy LAB_SERVICE_TOKEN, removed next release"
      },
      "instanceSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "LAB_INSTANCE_SECRET of the calling hosted engine (64 hex chars), with X-Lab-Instance-Id"
      },
      "instanceId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lab-Instance-Id",
        "description": "LAB_INSTANCE_ID (uuid)"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or wrong engine credentials (or, for events, a bad signature or stale timestamp)"
      }
    },
    "schemas": {
      "Ping": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "Inactive": {
        "type": "object",
        "required": [
          "active"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "Credits": {
        "type": "object",
        "required": [
          "balance"
        ],
        "properties": {
          "balance": {
            "type": "integer",
            "description": "Stored balance minus usage received but not yet debited"
          }
        }
      },
      "IntrospectionRequest": {
        "type": "object",
        "required": [
          "kind",
          "credential"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "api_key",
              "bearer",
              "session"
            ]
          },
          "credential": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "account_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Session only: the selected account (X-Account-Id). Defaults to the first membership."
          }
        }
      },
      "Principal": {
        "type": "object",
        "required": [
          "type",
          "user_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "api_key",
              "oauth",
              "session"
            ]
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "IntrospectionActive": {
        "type": "object",
        "required": [
          "active",
          "account_id",
          "tier",
          "role",
          "api_key_id",
          "principal",
          "credits",
          "cache_ttl"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "const": true
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "starter",
              "pro",
              "enterprise"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "Membership role for sessions, null otherwise"
          },
          "api_key_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          },
          "credits": {
            "$ref": "#/components/schemas/Credits"
          },
          "cache_ttl": {
            "type": "integer",
            "description": "Seconds the engine may cache this answer: 30, or fewer for a session or OAuth token that expires sooner (never past the credential's expiry; 0 = do not cache)"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits"
          }
        }
      },
      "Introspection": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/IntrospectionActive"
          },
          {
            "$ref": "#/components/schemas/Inactive"
          }
        ]
      },
      "AccountActive": {
        "type": "object",
        "required": [
          "active",
          "account_id",
          "tier",
          "credits",
          "cache_ttl"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "const": true
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "tier": {
            "type": "string",
            "enum": [
              "free",
              "starter",
              "pro",
              "enterprise"
            ]
          },
          "credits": {
            "$ref": "#/components/schemas/Credits"
          },
          "cache_ttl": {
            "type": "integer"
          },
          "limits": {
            "$ref": "#/components/schemas/PlanLimits"
          }
        }
      },
      "AccountLookup": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AccountActive"
          },
          {
            "$ref": "#/components/schemas/Inactive"
          }
        ]
      },
      "MeilisearchTarget": {
        "type": "object",
        "required": [
          "id",
          "url",
          "api_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "api_key": {
            "type": "string",
            "description": "Decrypted Meilisearch API key; empty string when none is set"
          }
        }
      },
      "NotFound": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "const": "not_found"
          }
        }
      },
      "PlanLimits": {
        "type": "object",
        "description": "Per-plan limits an engine enforces for the account's tier (contract v2 section 5)",
        "required": [
          "concurrent_jobs",
          "rate_limit_rpm",
          "max_depth",
          "js_rendering"
        ],
        "properties": {
          "concurrent_jobs": {
            "type": "integer"
          },
          "rate_limit_rpm": {
            "type": "integer"
          },
          "max_depth": {
            "type": "integer"
          },
          "js_rendering": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
