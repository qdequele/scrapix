# =============================================================================
# Scrapix Fly.io Multi-Target Dockerfile
# =============================================================================
# Builds all four Rust service binaries from a single cargo-chef-cached
# workspace build, then exposes a separate runtime stage per binary. CI picks
# the target via `docker buildx build --target <name>` and pushes each as its
# own tag to ghcr.io/meilisearch/scrapix-<name>:<sha>.
#
# Why cargo-chef: the previous Dockerfile.heroku builds used a stub-files hack
# to precompile dependencies; cargo-chef does this properly and survives
# workspace member additions without manual Dockerfile edits.
#
# Build targets:
#   scrapix-api                 — HTTP API server
#   scrapix-frontier-service    — URL frontier Kafka consumer
#   scrapix-worker-crawler      — Fetcher Kafka consumer (+ Chromium)
#   scrapix-worker-content      — Content parser Kafka consumer
# =============================================================================

# -----------------------------------------------------------------------------
# Stage: chef-base — toolchain + system build deps, cached once.
# -----------------------------------------------------------------------------
FROM rust:1.93-bookworm AS chef-base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        libssl-dev \
        libsasl2-dev \
        libclang-dev \
        libcurl4-openssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked --version 0.1.68

# -----------------------------------------------------------------------------
# Stage: planner — emits recipe.json capturing the full dependency graph.
# -----------------------------------------------------------------------------
FROM chef-base AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# -----------------------------------------------------------------------------
# Stage: builder — compiles deps once (cached), then workspace sources.
# -----------------------------------------------------------------------------
FROM chef-base AS builder
COPY --from=planner /app/recipe.json recipe.json
# Cook only dependencies — this layer is reused across source changes.
RUN cargo chef cook --release --recipe-path recipe.json --features browser
# Copy real sources and build every binary we deploy.
COPY . .
RUN cargo build --release --features browser \
        --bin scrapix-api \
        --bin scrapix-frontier-service \
        --bin scrapix-worker-crawler \
        --bin scrapix-worker-content

# -----------------------------------------------------------------------------
# PDFium — rasterizes scanned PDF pages for OCR (SCR-86). Loaded at runtime by
# scrapix-ocr (PDFIUM_LIB_PATH); never linked at build time. Pinned to the
# bblanchon/pdfium-binaries release firecrawl-pdfium 0.1.0 is tested against;
# the checksums come from its pdfium.lock.json and must change with the tag.
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS pdfium
ARG TARGETARCH
ARG PDFIUM_RELEASE=chromium/7988
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) asset=pdfium-linux-x64.tgz; sha=7358c15e26a746cd67854887ea11b3b807c436056788eee9294fb972b8f8e0be ;; \
      arm64) asset=pdfium-linux-arm64.tgz; sha=a2926203456881efa8feca7e0e409de78a4471b9b72e62a74c820faebb3e4551 ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/pdfium.tgz \
      "https://github.com/bblanchon/pdfium-binaries/releases/download/${PDFIUM_RELEASE}/${asset}"; \
    echo "${sha}  /tmp/pdfium.tgz" | sha256sum -c -; \
    mkdir -p /opt/pdfium; \
    tar -xzf /tmp/pdfium.tgz -C /opt/pdfium; \
    rm /tmp/pdfium.tgz; \
    test -f /opt/pdfium/lib/libpdfium.so

# -----------------------------------------------------------------------------
# Shared runtime base — non-root user, ca-certificates, libssl.
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime-base
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libsasl2-2 \
        libcurl4 \
        tini \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -s /bin/bash scrapix
USER scrapix
WORKDIR /app
ENV RUST_LOG=info
ENTRYPOINT ["/usr/bin/tini", "--"]

# -----------------------------------------------------------------------------
# Runtime with document parsing / OCR support (API, content worker).
# -----------------------------------------------------------------------------
FROM runtime-base AS runtime-documents
# Documents & OCR: Tesseract (local OCR backend, no API key needed) and the
# pinned PDFium build (page rasterization).
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*
COPY --from=pdfium /opt/pdfium /opt/pdfium
ENV PDFIUM_LIB_PATH=/opt/pdfium/lib
USER scrapix

# -----------------------------------------------------------------------------
# Target: scrapix-api
# -----------------------------------------------------------------------------
FROM runtime-documents AS scrapix-api
COPY --from=builder --chown=scrapix:scrapix /app/target/release/scrapix-api /app/scrapix-api
EXPOSE 8080
CMD ["/app/scrapix-api", "--port", "8080"]

# -----------------------------------------------------------------------------
# Target: scrapix-frontier-service
# -----------------------------------------------------------------------------
FROM runtime-base AS scrapix-frontier-service
COPY --from=builder --chown=scrapix:scrapix /app/target/release/scrapix-frontier-service /app/scrapix-frontier-service
EXPOSE 8081
CMD ["/app/scrapix-frontier-service"]

# -----------------------------------------------------------------------------
# Target: scrapix-worker-crawler — adds Chromium for browser rendering.
# -----------------------------------------------------------------------------
FROM debian:bookworm-slim AS scrapix-worker-crawler
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libsasl2-2 \
        libcurl4 \
        tini \
        chromium \
        fonts-liberation \
        fonts-noto \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -s /bin/bash scrapix
USER scrapix
WORKDIR /app
ENV RUST_LOG=info \
    CHROME_PATH=/usr/bin/chromium
COPY --from=builder --chown=scrapix:scrapix /app/target/release/scrapix-worker-crawler /app/scrapix-worker-crawler
EXPOSE 8081
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/scrapix-worker-crawler"]

# -----------------------------------------------------------------------------
# Target: scrapix-worker-content
# -----------------------------------------------------------------------------
FROM runtime-documents AS scrapix-worker-content
COPY --from=builder --chown=scrapix:scrapix /app/target/release/scrapix-worker-content /app/scrapix-worker-content
EXPOSE 8081
CMD ["/app/scrapix-worker-content"]
